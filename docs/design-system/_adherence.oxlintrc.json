{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/app/**",
              "components/core/**",
              "components/data/**",
              "ui_kits/scope-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Serif 4|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Source Serif 4, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssignmentRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|course|courseColor|type|due|magnitude|complete|watched|needsReview|onToggleComplete|onToggleWatch|onClick|key|ref|className|style|children)$/]",
        "message": "<AssignmentRow> doesn't accept that prop. Declared props: title, course, courseColor, type, due, magnitude, complete, watched, needsReview, onToggleComplete, onToggleWatch, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|pill|mono|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, pill, mono, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|warn|ok|danger|outline)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'warn' | 'ok' | 'danger' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|children|disabled|full|onClick|title|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, children, disabled, full, onClick, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|quiet|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|meta|actions|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, title, meta, actions, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|flat|accent|warn|danger)$/]",
        "message": "<Card> tone must be one of 'default' | 'flat' | 'accent' | 'warn' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourseDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|label|muted|key|ref|className|style|children)$/]",
        "message": "<CourseDot> doesn't accept that prop. Declared props: color, size, label, muted."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropZone'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|hint|filename|error|onPick|key|ref|className|style|children)$/]",
        "message": "<DropZone> doesn't accept that prop. Declared props: title, hint, filename, error, onPick."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeatCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:week|day|load|items|label|key|ref|className|style|children)$/]",
        "message": "<HeatCell> doesn't accept that prop. Declared props: week, day, load, items, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|detail|actions|key|ref|className|style|children)$/]",
        "message": "<HeroBanner> doesn't accept that prop. Declared props: eyebrow, title, detail, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|onChange|mono|width|invalid|readOnly|hint|suffix|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, placeholder, onChange, mono, width, invalid, readOnly, hint, suffix."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|label|children|actions|key|ref|className|style|children)$/]",
        "message": "<InsightBand> doesn't accept that prop. Declared props: tone, label, children, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warn|accent|danger|neutral)$/]",
        "message": "<InsightBand> tone must be one of 'warn' | 'accent' | 'danger' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|peak|key|ref|className|style|children)$/]",
        "message": "<LoadBar> doesn't accept that prop. Declared props: label, value, peak."
      },
      {
        "selector": "JSXOpeningElement[name.name='LockedTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:view|have|needs|action|key|ref|className|style|children)$/]",
        "message": "<LockedTab> doesn't accept that prop. Declared props: view, have, needs, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='LockedTab'] > JSXAttribute[name.name='view'] > Literal[value!=/^(?:Workload|Runway)$/]",
        "message": "<LockedTab> view must be one of 'Workload' | 'Runway'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|size|key|ref|className|style|children)$/]",
        "message": "<SegmentedToggle> doesn't accept that prop. Declared props: options, value, onChange, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedToggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<SegmentedToggle> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|color|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeriesGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|cadence|range|count|magnitude|expanded|onToggle|actions|children|moreLabel|key|ref|className|style|children)$/]",
        "message": "<SeriesGroup> doesn't accept that prop. Declared props: title, cadence, range, count, magnitude, expanded, onToggle, actions, children, moreLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarCourse'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|color|count|key|ref|className|style|children)$/]",
        "message": "<SidebarCourse> doesn't accept that prop. Declared props: name, color, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|sub|tone|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, unit, sub, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent)$/]",
        "message": "<StatTile> tone must be one of 'default' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|total|labels|key|ref|className|style|children)$/]",
        "message": "<StepBar> doesn't accept that prop. Declared props: step, total, labels."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwimlaneItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:week|label|magnitude|date|key|ref|className|style|children)$/]",
        "message": "<SwimlaneItem> doesn't accept that prop. Declared props: week, label, magnitude, date."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
